{
  "activationEvents": [
    "onLanguage",
    "onStartupFinished"
  ],
  "author": {
    "name": "Roo Code"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Snippets",
    "Testing"
  ],
  "contributes": {
    "commands": [
      {
        "command": "roo-cline.plusButtonClicked",
        "icon": "$(add)",
        "title": "%command.newTask.title%"
      },
      {
        "command": "roo-cline.mcpButtonClicked",
        "icon": "$(server)",
        "title": "%command.mcpServers.title%"
      },
      {
        "command": "roo-cline.promptsButtonClicked",
        "icon": "$(notebook)",
        "title": "%command.prompts.title%"
      },
      {
        "command": "roo-cline.historyButtonClicked",
        "icon": "$(history)",
        "title": "%command.history.title%"
      },
      {
        "command": "roo-cline.popoutButtonClicked",
        "icon": "$(link-external)",
        "title": "%command.openInEditor.title%"
      },
      {
        "command": "roo-cline.settingsButtonClicked",
        "icon": "$(settings-gear)",
        "title": "%command.settings.title%"
      },
      {
        "category": "%configuration.title%",
        "command": "roo-cline.openInNewTab",
        "title": "%command.openInNewTab.title%"
      },
      {
        "category": "%configuration.title%",
        "command": "roo-cline.explainCode",
        "title": "%command.explainCode.title%"
      },
      {
        "category": "%configuration.title%",
        "command": "roo-cline.fixCode",
        "title": "%command.fixCode.title%"
      },
      {
        "category": "%configuration.title%",
        "command": "roo-cline.improveCode",
        "title": "%command.improveCode.title%"
      },
      {
        "category": "%configuration.title%",
        "command": "roo-cline.addToContext",
        "title": "%command.addToContext.title%"
      },
      {
        "category": "%configuration.title%",
        "command": "roo-cline.newTask",
        "title": "%command.newTask.title%"
      },
      {
        "category": "Terminal",
        "command": "roo-cline.terminalAddToContext",
        "title": "%command.terminal.addToContext.title%"
      },
      {
        "category": "Terminal",
        "command": "roo-cline.terminalFixCommand",
        "title": "%command.terminal.fixCommand.title%"
      },
      {
        "category": "Terminal",
        "command": "roo-cline.terminalExplainCommand",
        "title": "%command.terminal.explainCommand.title%"
      },
      {
        "category": "%configuration.title%",
        "command": "roo-cline.setCustomStoragePath",
        "title": "%command.setCustomStoragePath.title%"
      },
      {
        "category": "%configuration.title%",
        "command": "roo-cline.focusInput",
        "title": "%command.focusInput.title%"
      },
      {
        "category": "%configuration.title%",
        "command": "roo.acceptInput",
        "title": "%command.acceptInput.title%"
      }
    ],
    "configuration": {
      "properties": {
        "roo-cline.allowedCommands": {
          "default": [
            "npm test",
            "npm install",
            "tsc",
            "git log",
            "git diff",
            "git show"
          ],
          "description": "%commands.allowedCommands.description%",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "roo-cline.customStoragePath": {
          "default": "",
          "description": "%settings.customStoragePath.description%",
          "type": "string"
        },
        "roo-cline.vsCodeLmModelSelector": {
          "description": "%settings.vsCodeLmModelSelector.description%",
          "properties": {
            "family": {
              "description": "%settings.vsCodeLmModelSelector.family.description%",
              "type": "string"
            },
            "vendor": {
              "description": "%settings.vsCodeLmModelSelector.vendor.description%",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "title": "%configuration.title%"
    },
    "menus": {
      "editor/context": [
        {
          "group": "navigation",
          "submenu": "roo-code.contextMenu"
        }
      ],
      "editor/title": [
        {
          "command": "roo-cline.plusButtonClicked",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == roo-cline.TabPanelProvider"
        },
        {
          "command": "roo-cline.promptsButtonClicked",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == roo-cline.TabPanelProvider"
        },
        {
          "command": "roo-cline.mcpButtonClicked",
          "group": "navigation@3",
          "when": "activeWebviewPanelId == roo-cline.TabPanelProvider"
        },
        {
          "command": "roo-cline.historyButtonClicked",
          "group": "navigation@4",
          "when": "activeWebviewPanelId == roo-cline.TabPanelProvider"
        },
        {
          "command": "roo-cline.popoutButtonClicked",
          "group": "navigation@5",
          "when": "activeWebviewPanelId == roo-cline.TabPanelProvider"
        },
        {
          "command": "roo-cline.settingsButtonClicked",
          "group": "navigation@6",
          "when": "activeWebviewPanelId == roo-cline.TabPanelProvider"
        }
      ],
      "roo-code.contextMenu": [
        {
          "command": "roo-cline.addToContext",
          "group": "1_actions@1"
        },
        {
          "command": "roo-cline.explainCode",
          "group": "1_actions@2"
        },
        {
          "command": "roo-cline.improveCode",
          "group": "1_actions@3"
        }
      ],
      "roo-code.terminalMenu": [
        {
          "command": "roo-cline.terminalAddToContext",
          "group": "1_actions@1"
        },
        {
          "command": "roo-cline.terminalFixCommand",
          "group": "1_actions@2"
        },
        {
          "command": "roo-cline.terminalExplainCommand",
          "group": "1_actions@3"
        }
      ],
      "terminal/context": [
        {
          "group": "navigation",
          "submenu": "roo-code.terminalMenu"
        }
      ],
      "view/title": [
        {
          "command": "roo-cline.plusButtonClicked",
          "group": "navigation@1",
          "when": "view == roo-cline.SidebarProvider"
        },
        {
          "command": "roo-cline.promptsButtonClicked",
          "group": "navigation@2",
          "when": "view == roo-cline.SidebarProvider"
        },
        {
          "command": "roo-cline.mcpButtonClicked",
          "group": "navigation@3",
          "when": "view == roo-cline.SidebarProvider"
        },
        {
          "command": "roo-cline.historyButtonClicked",
          "group": "navigation@4",
          "when": "view == roo-cline.SidebarProvider"
        },
        {
          "command": "roo-cline.popoutButtonClicked",
          "group": "navigation@5",
          "when": "view == roo-cline.SidebarProvider"
        },
        {
          "command": "roo-cline.settingsButtonClicked",
          "group": "navigation@6",
          "when": "view == roo-cline.SidebarProvider"
        }
      ]
    },
    "submenus": [
      {
        "id": "roo-code.contextMenu",
        "label": "%views.contextMenu.label%"
      },
      {
        "id": "roo-code.terminalMenu",
        "label": "%views.terminalMenu.label%"
      }
    ],
    "views": {
      "roo-cline-ActivityBar": [
        {
          "id": "roo-cline.SidebarProvider",
          "name": "",
          "type": "webview"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "icon": "assets/icons/icon.svg",
          "id": "roo-cline-ActivityBar",
          "title": "%views.activitybar.title%"
        }
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.10.2",
    "@anthropic-ai/sdk": "^0.37.0",
    "@anthropic-ai/vertex-sdk": "^0.7.0",
    "@aws-sdk/client-bedrock-runtime": "^3.779.0",
    "@google/genai": "^0.12.0",
    "@mistralai/mistralai": "^1.3.6",
    "@modelcontextprotocol/sdk": "^1.7.0",
    "@types/clone-deep": "^4.0.4",
    "@types/pdf-parse": "^1.1.4",
    "@types/tmp": "^0.2.6",
    "@types/turndown": "^5.0.5",
    "@types/vscode": "^1.95.0",
    "@vscode/codicons": "^0.0.36",
    "axios": "^1.7.4",
    "cheerio": "^1.0.0",
    "chokidar": "^4.0.1",
    "clone-deep": "^4.0.1",
    "default-shell": "^2.2.0",
    "delay": "^6.0.0",
    "diff": "^5.2.0",
    "diff-match-patch": "^1.0.5",
    "fast-deep-equal": "^3.1.3",
    "fast-xml-parser": "^4.5.1",
    "fastest-levenshtein": "^1.0.16",
    "fzf": "^0.5.2",
    "get-folder-size": "^5.0.0",
    "i18next": "^24.2.2",
    "isbinaryfile": "^5.0.2",
    "mammoth": "^1.8.0",
    "monaco-vscode-textmate-theme-converter": "^0.1.7",
    "node-cache": "^5.1.2",
    "node-ipc": "^12.0.0",
    "openai": "^4.78.1",
    "os-name": "^6.0.0",
    "p-wait-for": "^5.0.2",
    "pdf-parse": "^1.1.1",
    "pkce-challenge": "^4.1.0",
    "posthog-node": "^4.7.0",
    "pretty-bytes": "^6.1.1",
    "ps-tree": "^1.2.0",
    "puppeteer-chromium-resolver": "^23.0.0",
    "puppeteer-core": "^23.4.0",
    "reconnecting-eventsource": "^1.6.4",
    "say": "^0.16.0",
    "serialize-error": "^11.0.3",
    "simple-git": "^3.27.0",
    "sound-play": "^1.1.0",
    "string-similarity": "^4.0.4",
    "strip-ansi": "^7.1.0",
    "strip-bom": "^5.0.0",
    "tiktoken": "^1.0.21",
    "tmp": "^0.2.3",
    "tree-sitter-wasms": "^0.1.11",
    "turndown": "^7.2.0",
    "vscode-material-icons": "^0.1.1",
    "web-tree-sitter": "^0.22.6",
    "workerpool": "^9.2.0",
    "zod": "^3.23.8"
  },
  "description": "%extension.description%",
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@changesets/types": "^6.0.0",
    "@dotenvx/dotenvx": "^1.34.0",
    "@types/debug": "^4.1.12",
    "@types/diff": "^5.2.1",
    "@types/diff-match-patch": "^1.0.36",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/node-cache": "^4.1.3",
    "@types/node-ipc": "^9.2.3",
    "@types/ps-tree": "^1.1.6",
    "@types/string-similarity": "^4.0.2",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.0",
    "execa": "^9.5.2",
    "glob": "^11.0.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-simple-dot-reporter": "^1.0.5",
    "knip": "^5.44.4",
    "lint-staged": "^15.2.11",
    "mkdirp": "^3.0.1",
    "nock": "^14.0.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.4.5",
    "vitest": "^3.1.2",
    "zod-to-ts": "^1.2.0"
  },
  "displayName": "%extension.displayName%",
  "engines": {
    "node": "20.18.1",
    "vscode": "^1.84.0"
  },
  "galleryBanner": {
    "color": "#617A91",
    "theme": "dark"
  },
  "homepage": "https://github.com/RooVetGit/Roo-Code",
  "icon": "assets/icons/icon.png",
  "keywords": [
    "cline",
    "claude",
    "dev",
    "mcp",
    "openrouter",
    "coding",
    "agent",
    "autonomous",
    "chatgpt",
    "sonnet",
    "ai",
    "llama",
    "roo code",
    "roocode"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ],
    "src/**/*.{ts,tsx}": [
      "npx eslint -c .eslintrc.json --max-warnings=0 --fix"
    ],
    "webview-ui/**/*.{ts,tsx}": [
      "npx eslint -c webview-ui/.eslintrc.json --max-warnings=0 --fix"
    ]
  },
  "main": "./dist/extension.js",
  "name": "roo-cline",
  "publisher": "RooVeterinaryInc",
  "repository": {
    "type": "git",
    "url": "https://github.com/RooVetGit/Roo-Code"
  },
  "scripts": {
    "build": "npm run vsix",
    "build:esbuild": "node esbuild.js --production",
    "build:then-test": "node scripts/build-then-test.js",
    "build:webview": "cd webview-ui && npm run build",
    "changeset": "changeset",
    "check-types": "npm-run-all -l -p check-types:*",
    "check-types:e2e": "cd e2e && npm run check-types",
    "check-types:extension": "tsc --noEmit",
    "check-types:webview": "cd webview-ui && npm run check-types",
    "clean": "npm-run-all -l -p clean:*",
    "clean:e2e": "cd e2e && npm run clean",
    "clean:extension": "rimraf bin dist out",
    "clean:webview": "cd webview-ui && npm run clean",
    "compile": "tsc -p . --outDir out && node esbuild.js",
    "dev": "cd webview-ui && npm run dev",
    "generate-types": "tsx scripts/generate-types.mts",
    "install-e2e": "cd e2e && pnpm install",
    "install-extension": "pnpm install",
    "install-webview": "cd webview-ui && pnpm install",
    "install:all": "pnpm install npm-run-all && npm-run-all -l -p install-*",
    "knip": "knip --include files",
    "lint": "npm-run-all -l -p lint:*",
    "lint:e2e": "cd e2e && npm run lint",
    "lint:extension": "eslint src --ext .ts",
    "lint:webview": "cd webview-ui && npm run lint",
    "package": "npm-run-all -l -p build:webview build:esbuild check-types lint",
    "prepare": "husky",
    "pretest": "npm run compile",
    "publish": "npm run build && changeset publish && pnpm install --package-lock-only",
    "publish:marketplace": "vsce publish && ovsx publish",
    "test": "npm-run-all test:*",
    "test:extension": "jest -w=40%",
    "test:extension-esm": "vitest run",
    "test:webview": "cd webview-ui && npm run test",
    "update-contributors": "node scripts/update-contributors.js",
    "version-packages": "changeset version && pnpm install --package-lock-only",
    "vscode-test": "npm-run-all -l -p vscode-test:*",
    "vscode-test:extension": "tsc -p . --outDir out && node esbuild.js",
    "vscode-test:webview": "cd webview-ui && npm run build",
    "vscode:prepublish": "npm run package",
    "vsix": "rimraf bin && mkdirp bin && npx vsce package --out bin",
    "watch": "npm-run-all -l -p watch:*",
    "watch-tests": "tsc -p . -w --outDir out",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json"
  },
  "version": "3.16.3"
}